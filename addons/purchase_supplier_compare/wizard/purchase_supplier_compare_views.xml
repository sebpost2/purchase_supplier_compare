<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_supplier_compare_view_form" model="ir.ui.view">
        <field name="name">purchase.supplier.compare.form</field>
        <field name="model">purchase.supplier.compare</field>
        <field name="arch" type="xml">
            <form string="Compare suppliers">
                <p class="text-muted">
                    Each vendor's own prices for these quantities (quantity tiers included), plus its freight and
                    other extra costs. Taxes excluded.
                </p>
                <field name="currency_id" invisible="1"/>
                <field name="line_ids" nolabel="1">
                    <list create="0" delete="0" decoration-success="is_cheapest" decoration-muted="missing_products">
                        <field name="currency_id" column_invisible="1"/>
                        <field name="is_current" column_invisible="1"/>
                        <field name="is_cheapest" column_invisible="1"/>
                        <field name="partner_id"/>
                        <field name="goods_amount"/>
                        <field name="extra_amount"/>
                        <field name="total_amount" class="fw-bold"/>
                        <field name="missing_products" optional="show"/>
                        <button name="action_choose" type="object" string="Choose" class="btn-primary"
                                invisible="missing_products or is_current"/>
                    </list>
                </field>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
