<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_extra_costs" model="ir.ui.view">
        <field name="name">res.partner.form.purchase.extra.costs</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <separator string="Extra costs per purchase" groups="purchase.group_purchase_user"/>
                <field name="purchase_extra_cost_ids" nolabel="1" groups="purchase.group_purchase_user">
                    <list editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="name"/>
                        <field name="cost_type"/>
                        <field name="amount"/>
                        <field name="company_currency_id" column_invisible="1"/>
                        <field name="waived_above"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
